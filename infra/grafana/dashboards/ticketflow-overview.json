{
  "uid": "ticketflow-overview",
  "title": "TicketFlow — visão geral",
  "description": "O caminho de um pedido: entra pela API, atravessa o outbox e o Kafka, e termina cobrado. Cada painel responde a uma pergunta que só faz sentido num sistema assíncrono.",
  "tags": ["ticketflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pedidos aceitos por minuto",
      "description": "POST /orders respondendo 202. É a entrada do sistema; tudo o mais decorre daqui.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqpm", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"order-service\",uri=\"/api/v1/orders\",method=\"POST\"}[1m])) by (status) * 60",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Backlog do outbox",
      "description": "PENDING subindo significa que o relay parou ou o broker sumiu — e a API continua respondendo 202 sem ninguém a jusante ficar sabendo. FAILED acima de zero pede intervenção humana.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ticketflow_outbox_messages{application=\"order-service\"}",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Resultado das cobranças",
      "description": "Aprovado e recusado são respostas do gateway. TIMEOUT e ERROR não são: ninguém sabe se o dinheiro se moveu, e é o par que sobe primeiro quando o provedor começa a falhar.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(ticketflow_payment_gateway_calls_seconds_count[5m])) by (outcome) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latência do gateway (p95 e p99)",
      "description": "O read-timeout do serviço é 5s. Quando o p99 encosta nele, os TIMEOUT do painel ao lado começam.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ticketflow_payment_gateway_calls_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ticketflow_payment_gateway_calls_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Serviços de pé",
      "description": "Um alvo que some do Prometheus é um serviço que caiu.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA", "color": "red" }, "1": { "text": "no ar", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "up{job=~\".*-service\"}", "legendFormat": "{{job}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latência da API (p95 por rota)",
      "description": "POST /orders tem que ser rápido justamente porque não espera o pagamento. Se subir, a premissa do projeto está sendo violada em algum lugar.",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"order-service\",uri!~\"/actuator.*\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memória JVM em uso",
      "description": "Heap por serviço. O básico que se olha antes de culpar o negócio.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (application)",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    }
  ]
}
