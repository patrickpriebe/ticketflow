# Normalise line endings so the repo behaves the same on Windows and Linux.
* text=auto eol=lf

# Scripts that run inside Linux containers MUST keep LF, otherwise bash fails
# with the classic "/bin/bash^M: bad interpreter".
*.sh   text eol=lf
mvnw   text eol=lf

# Windows-only scripts keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binaries.
*.jar  binary
*.png  binary
*.jpg  binary
*.ico  binary
