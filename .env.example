# Copy to .env before running docker compose:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# These are LOCAL DEVELOPMENT credentials. Never reuse them anywhere real.

# --- PostgreSQL ---
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
# Host port only. Inside the Docker network Postgres is always on 5432.
# Defaults to 5433 to avoid clashing with a native PostgreSQL install.
POSTGRES_PORT=5433

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
MONGO_PORT=27017

# --- Kafka ---
KAFKA_EXTERNAL_PORT=9092

# --- Aplicação (perfil `apps`) ---
# Host ports only; dentro do container as portas não mudam.
ORDER_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
PAYMENT_GATEWAY_PORT=8090

# --- Autenticação ---
# Fora dos perfis `local` e `docker` estas duas NÃO têm valor padrão: o serviço se
# recusa a subir sem a chave, e o emissor de token vem desligado. É deliberado —
# havia um padrão publicado neste repositório, e um ambiente que suba com a chave
# de exemplo aceita token forjado por qualquer pessoa.
#
# No compose os dois já vêm com valor de brincadeira; só descomente para trocar.
# TICKETFLOW_AUTH_SECRET=troque-isto-por-32-caracteres-ou-mais
# TICKETFLOW_DEV_TOKENS=true

# --- AWS simulada (perfil `aws`) ---
LOCALSTACK_PORT=4566
# Ligue junto com o perfil `aws` para o Notification Service arquivar no S3.
TICKETFLOW_ARCHIVE_ENABLED=false

# --- Observabilidade (perfil `observability`) ---
# Portas de host. Dentro da rede Docker não mudam.
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002

# --- Web UIs ---
KAFKA_UI_PORT=8085
