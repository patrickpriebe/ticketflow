# Copy to .env before running docker compose:
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# These are LOCAL DEVELOPMENT credentials. Never reuse them anywhere real.

# --- PostgreSQL ---
POSTGRES_USER=ticketflow
POSTGRES_PASSWORD=ticketflow
# Host port only. Inside the Docker network Postgres is always on 5432.
# Defaults to 5433 to avoid clashing with a native PostgreSQL install.
POSTGRES_PORT=5433

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root
MONGO_PORT=27017

# --- Kafka ---
KAFKA_EXTERNAL_PORT=9092

# --- Aplicação (perfil `apps`) ---
# Host ports only; dentro do container as portas não mudam.
ORDER_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
PAYMENT_GATEWAY_PORT=8090

# --- Autenticação ---
# Fora dos perfis `local` e `docker` estas duas NÃO têm valor padrão: o serviço se
# recusa a subir sem a chave, e o emissor de token vem desligado. É deliberado —
# havia um padrão publicado neste repositório, e um ambiente que suba com a chave
# de exemplo aceita token forjado por qualquer pessoa.
#
# No compose os dois já vêm com valor de brincadeira; só descomente para trocar.
# TICKETFLOW_AUTH_SECRET=troque-isto-por-32-caracteres-ou-mais
# TICKETFLOW_DEV_TOKENS=true

# --- AWS simulada (perfil `aws`) ---
LOCALSTACK_PORT=4566
# Ligue junto com o perfil `aws` para o Notification Service arquivar no S3.
TICKETFLOW_ARCHIVE_ENABLED=false

# --- Observabilidade (perfil `observability`) ---
# Portas de host. Dentro da rede Docker não mudam.
PROMETHEUS_PORT=9091
GRAFANA_PORT=3002

# --- Web UIs ---
KAFKA_UI_PORT=8085
NOTIFICATION_SERVICE_PORT=8083

# =============================================================================
# Nuvem gerenciada (docker-compose.cloud.yml, perfil Spring `cloud`)
#
# Só os NOMES ficam aqui. Os valores vão para o `.env`, que o git ignora — e é
# por isso que este arquivo existe: alguém que clona o repositório descobre o
# que precisa preencher sem que nenhum segredo tenha sido publicado.
#
# Nenhuma destas tem valor padrão na aplicação: faltar derruba o boot, de
# propósito.
# =============================================================================

# --- Order Service: Supabase ---
# ATENÇÃO: use o *session pooler*, não a conexão direta.
# A direta só responde em IPv6 e o Render sai por IPv4; o transaction pooler
# (6543) quebra prepared statements do Hibernate. O session pooler é IPv4 e
# mantém a sessão.
#   jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# POSTGRES_ORDERS_URL=
# POSTGRES_ORDERS_USER=postgres.<referencia-do-projeto>
# POSTGRES_ORDERS_PASSWORD=

# --- Payment Service: Neon ---
#   jdbc:postgresql://<endpoint>.neon.tech/neondb?sslmode=require
# POSTGRES_PAYMENTS_URL=
# POSTGRES_PAYMENTS_USER=neondb_owner
# POSTGRES_PAYMENTS_PASSWORD=

# --- Notification Service: MongoDB Atlas ---
# A URI carrega usuário e senha; é segredo inteiro.
#   mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/ticketflow_notifications?retryWrites=true&w=majority
# MONGO_URI=

# --- Kafka: Redpanda Cloud (SASL_SSL + SCRAM-SHA-256) ---
# KAFKA_BOOTSTRAP=<id>.any.<regiao>.mpx.prd.cloud.redpanda.com:9092
# KAFKA_USER=ticketflow
# KAFKA_PASSWORD=

# --- Identidade: um dos dois caminhos, nunca nenhum ---
#
# Caminho A, provedor de verdade (o dos ambientes publicados). Os dois serviços
# validam o token contra a chave pública do Google. AUDIENCE é o client id do
# OAuth, e é obrigatório: sem ele, um token do Google emitido para outro site
# entra aqui como login válido, com o `sub` real da pessoa.
# TICKETFLOW_AUTH_ISSUER_URI=https://accounts.google.com
# TICKETFLOW_AUTH_AUDIENCE=<client-id>.apps.googleusercontent.com
#
# Caminho B, emissor simétrico (para depurar a pilha local contra a nuvem sem
# precisar de conta em provedor nenhum). Mínimo de 32 caracteres; gere um valor
# aleatório e não reaproveite o de exemplo.
# TICKETFLOW_AUTH_SECRET=
#
# Faltando os dois, o boot cai de propósito.
