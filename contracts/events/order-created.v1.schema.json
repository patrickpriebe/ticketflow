{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticketflow.dev/schemas/events/order-created.v1.json",
  "title": "ORDER_CREATED (v1)",
  "description": "Published by Order Service to `ticketflow.orders.created` in the same transaction that inserts the order (transactional outbox). Consumed by Payment Service.\n\nThe payload carries everything Payment Service needs to charge the customer. It deliberately does NOT carry card data: the customer's payment credentials go straight from the client to the gateway, never through Kafka.",
  "allOf": [{ "$ref": "./envelope.schema.json" }],
  "type": "object",
  "properties": {
    "eventType": { "const": "ORDER_CREATED" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "order-service" },
    "data": {
      "type": "object",
      "required": ["orderId", "customerId", "customerEmail", "eventId", "paymentMethod", "totalAmount", "currency", "items"],
      "additionalProperties": false,
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string", "format": "email" },
        "eventId": {
          "type": "string",
          "format": "uuid",
          "description": "The ticketed event (show/match), not the message id. Named `eventId` inside `data` and `envelope.eventId` outside - keep them straight."
        },
        "eventName": { "type": "string" },
        "paymentMethod": {
          "type": "string",
          "enum": ["CREDIT_CARD", "PIX", "BOLETO"],
          "description": "Selects the PaymentStrategy on the consumer side."
        },
        "totalAmount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["ticketCategoryId", "categoryName", "quantity", "unitPrice"],
            "additionalProperties": false,
            "properties": {
              "ticketCategoryId": { "type": "string", "format": "uuid" },
              "categoryName": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "unitPrice": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "eventId": "6f1a2b3c-4d5e-4f60-8a1b-2c3d4e5f6a7b",
      "eventType": "ORDER_CREATED",
      "eventVersion": 1,
      "occurredAt": "2026-08-10T14:03:21Z",
      "producer": "order-service",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "correlationId": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "data": {
        "orderId": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "customerId": "3f1c9a6e-77b2-4c0d-9f31-2a5b8e4d6c10",
        "customerName": "Ana Souza",
        "customerEmail": "ana.souza@example.com",
        "eventId": "11111111-1111-4111-8111-111111111111",
        "eventName": "Rock in Rio 2026 - Dia 1",
        "paymentMethod": "CREDIT_CARD",
        "totalAmount": 1300.00,
        "currency": "BRL",
        "items": [
          {
            "ticketCategoryId": "aaaaaaaa-0001-4000-8000-000000000001",
            "categoryName": "Pista",
            "quantity": 2,
            "unitPrice": 650.00
          }
        ]
      }
    }
  ]
}
