{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticketflow.dev/schemas/events/payment-processed.v1.json",
  "title": "PAGAMENTO_APROVADO / PAGAMENTO_RECUSADO (v1)",
  "description": "Published by Payment Service to `ticketflow.payments.processed` after the external gateway answers. Consumed by two services at once:\n\n  * Order Service      - moves the order PENDING -> PAID or REJECTED\n  * Notification Service - issues the ticket (approved) or the failure notice (rejected)\n\nBoth outcomes share one topic on purpose. Two topics would break the ordering guarantee between them, and a consumer that cares about one usually cares about the other too. The `eventType` discriminator is what tells them apart.\n\nThe two Portuguese names are fixed project vocabulary; everything else in the codebase is English.",
  "allOf": [{ "$ref": "./envelope.schema.json" }],
  "type": "object",
  "properties": {
    "eventType": { "enum": ["PAGAMENTO_APROVADO", "PAGAMENTO_RECUSADO"] },
    "eventVersion": { "const": 1 },
    "producer": { "const": "payment-service" },
    "data": {
      "type": "object",
      "required": ["paymentId", "orderId", "customerId", "amount", "currency", "method", "processedAt"],
      "additionalProperties": false,
      "properties": {
        "paymentId": { "type": "string", "format": "uuid" },
        "orderId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "amount": { "type": "number", "minimum": 0 },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
        "method": { "type": "string", "enum": ["CREDIT_CARD", "PIX", "BOLETO"] },
        "processedAt": { "type": "string", "format": "date-time" },
        "gatewayName": { "type": "string", "examples": ["acme-payments"] },
        "gatewayTransactionId": {
          "type": "string",
          "description": "Required when eventType is PAGAMENTO_APROVADO."
        },
        "failureCode": {
          "type": "string",
          "description": "Present only on PAGAMENTO_RECUSADO.",
          "examples": ["INSUFFICIENT_FUNDS", "CARD_EXPIRED", "FRAUD_SUSPECTED", "GATEWAY_TIMEOUT"]
        },
        "failureReason": { "type": "string" },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "description": "How many calls to the gateway it took. Above 1 means retries happened - useful when reading the Grafana panels in phase 3."
        }
      }
    }
  },
  "allOf_conditions_note": "The rules below encode 'approved must carry a transaction id, rejected must carry a reason'.",
  "if": {
    "properties": { "eventType": { "const": "PAGAMENTO_APROVADO" } }
  },
  "then": {
    "properties": {
      "data": { "required": ["gatewayTransactionId"] }
    }
  },
  "else": {
    "properties": {
      "data": { "required": ["failureCode"] }
    }
  },
  "examples": [
    {
      "eventId": "9c8b7a65-4321-4def-8abc-1234567890ab",
      "eventType": "PAGAMENTO_APROVADO",
      "eventVersion": 1,
      "occurredAt": "2026-08-10T14:03:24Z",
      "producer": "payment-service",
      "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
      "correlationId": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
      "data": {
        "paymentId": "b2c3d4e5-f6a7-4b89-9c0d-1e2f3a4b5c6d",
        "orderId": "7c9e6679-7425-40de-944b-e07fc1f90ae7",
        "customerId": "3f1c9a6e-77b2-4c0d-9f31-2a5b8e4d6c10",
        "amount": 1300.00,
        "currency": "BRL",
        "method": "CREDIT_CARD",
        "processedAt": "2026-08-10T14:03:24Z",
        "gatewayName": "acme-payments",
        "gatewayTransactionId": "ch_3PqR7s2eZvKYlo2C1gLmNoP4",
        "attempts": 1
      }
    },
    {
      "eventId": "1a2b3c4d-5e6f-4071-8283-94a5b6c7d8e9",
      "eventType": "PAGAMENTO_RECUSADO",
      "eventVersion": 1,
      "occurredAt": "2026-08-10T14:05:02Z",
      "producer": "payment-service",
      "correlationId": "0d1e2f3a-4b5c-4d6e-8f90-a1b2c3d4e5f6",
      "data": {
        "paymentId": "c3d4e5f6-a7b8-4c90-9d1e-2f3a4b5c6d7e",
        "orderId": "0d1e2f3a-4b5c-4d6e-8f90-a1b2c3d4e5f6",
        "customerId": "3f1c9a6e-77b2-4c0d-9f31-2a5b8e4d6c10",
        "amount": 2400.00,
        "currency": "BRL",
        "method": "CREDIT_CARD",
        "processedAt": "2026-08-10T14:05:02Z",
        "gatewayName": "acme-payments",
        "failureCode": "INSUFFICIENT_FUNDS",
        "failureReason": "Card declined by issuer",
        "attempts": 1
      }
    }
  ]
}
